{
  "name": "@non-standardworld/stone-engine",
  "version": "0.1.0",
  "description": "日本語組版エンジン stone_engine の JavaScript / TypeScript 移植。縦書き・禁則処理・約物半角・縦中横・文字種ごとのフォント指定を、ブラウザ標準のフォント描画の上で実現します。React 用コンポーネント同梱。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "npm run dev --workspace examples/react-router",
    "site": "npm run dev --workspace site",
    "site:build": "npm run build --workspace site"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "examples/*",
    "site"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/non-standardworld/stone_engine_js.git"
  },
  "keywords": [
    "japanese",
    "typesetting",
    "vertical-writing",
    "tategaki",
    "kinsoku",
    "react",
    "svg"
  ]
}
